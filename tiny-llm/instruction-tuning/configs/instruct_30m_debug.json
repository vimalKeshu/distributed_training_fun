{
  "run_name": "instruct_30m_debug",
  "seed": 1337,
  "data": {
    "tokenizer_path": "data/tinystories/tokenizer.json",
    "train_text_path": "data/tinystories_instruct/valid_1M_tokens.txt",
    "valid_text_path": "data/tinystories_instruct/valid_1M_tokens.txt",
    "cache_dir": "instruction-tuning/outputs/cache/tinystories_instruct_bpe4k_debug",
    "require_story_marker": true,
    "overwrite_cache": false
  },
  "model": {
    "block_size": 512
